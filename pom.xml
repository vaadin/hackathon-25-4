<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Scaffolded from vaadin/walking-skeleton v25.4-flow plus the
         spec driven files of vaadin/spec-driven-development-demo,
         assembled the way start.vaadin.com builds its sdd starter. -->
    <groupId>com.vaadin.securitystatus</groupId>
    <artifactId>security-status</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    
    <properties>
        <java.version>21</java.version>
        <vaadin.version>25.4.0-beta2</vaadin.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <surefire.excludedGroups>live-ai</surefire.excludedGroups>
    </properties>
    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0-RC2</version>
        <relativePath/>
    </parent>
    
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <dependencies>
        <dependency>
            <groupId>com.vaadin</groupId>
            <!-- Replace artifactId with vaadin-core to use only free components -->
            <artifactId>vaadin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>hilla-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <!-- Writes the verdict YAML of the workbench. Spring Boot already brings
             it; declared because the application now uses it directly. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- Composes the audit report PDF on the server. Pure Java, the
             standard fonts are built in, nothing is fetched at render time. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>
        <!-- Spring AI's chat API, without any model: SpringAILLMProvider is
             built from a ChatModel, so the code choosing the provider compiles
             without the key. The model itself comes only with the ai profile. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-testbench-junit6</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Tests tagged live-ai call a real model and never run by default.
                 Surefire's own property is excludedGroups, so the one above is
                 handed to it here; -Dsurefire.excludedGroups= lifts it.
                 Two forks cut the suite by a fifth; each fork boots its own Spring
                 context, so more forks than that make it slower, not faster. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                    <forkCount>2</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
                <!-- The PDF Viewer is commercial, and with it the default build creates
                     an application bundle, which fails without a licence. The default
                     build, the gate, must pass on a machine without one, so there it
                     builds with Vaadin's own banner instead. The production profile
                     below keeps the failure. -->
                <configuration>
                    <commercialWithBanner>true</commercialWithBanner>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
    <profiles>
        <!-- The real assistant. vaadin-ai-core-flow already ships
             SpringAILLMProvider, so all this profile adds is the model behind
             it. Without the profile there is no ChatModel on the classpath and
             the mock is the only provider, which is what the default build and
             every test run against.

             Activated by the presence of the key rather than activeByDefault,
             because Maven turns every activeByDefault profile off the moment
             any other profile is named, so -Pit would silently take the
             assistant away. -->
        <profile>
            <id>ai</id>
            <activation>
                <property>
                    <name>env.OPENAI_API_KEY</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-starter-model-openai</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!-- The browser tier. Starts the application, runs every *IT against a
             real browser, and stops it again: ./mvnw verify -Pit
             Surefire never sees these, because *IT does not match its default
             includes, so the ordinary gate stays fast and needs no browser. -->
        <profile>
            <id>it</id>
            <properties>
                <it.port>8081</it.port>
                <!-- Where the browser tests serve the committed fixtures, standing in
                     for GitHub Pages, so this run needs no network either. -->
                <it.pages.port>8082</it.pages.port>
                <it.headless>true</it.headless>
            </properties>
            <build>
                <plugins>
                    <!-- Always a fresh production bundle. The local
                         src/main/bundles/prod.bundle is git ignored and reused
                         whenever its imports cover the scanned ones, even when a
                         route is new, and then the new route's layout never loads,
                         D-156, flow#26338. -->
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <configuration>
                            <forceProductionBuild>true</forceProductionBuild>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>start-for-it</id>
                                <goals><goal>start</goal></goals>
                                <configuration>
                                    <arguments>
                                        <argument>--server.port=${it.port}</argument>
                                        <argument>--securitystatus.pages.base-url=http://localhost:${it.pages.port}/cve-status/</argument>
                                        <argument>--securitystatus.drafts.dir=${project.build.directory}/it-drafts</argument>
                                        <argument>--securitystatus.assistant.recorded=true</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stop-for-it</id>
                                <goals><goal>stop</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <it.port>${it.port}</it.port>
                                <it.pages.port>${it.pages.port}</it.pages.port>
                                <it.headless>${it.headless}</it.headless>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- The production frontend build, which is also where the commercial
             licence is enforced. -->
        <profile>
            <id>production</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <executions>
                            <execution>
                                <id>frontend</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>prepare-frontend</goal>
                                    <goal>build-frontend</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <productionMode>true</productionMode>
                            <commercialWithBanner>false</commercialWithBanner>
                            <!-- Never the stale local bundle, D-156. -->
                            <forceProductionBuild>true</forceProductionBuild>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>vaadin-directory</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
        </repository>
        <repository>
            <id>vaadin-prereleases</id>
            <url>https://maven.vaadin.com/vaadin-prereleases</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
    
    <pluginRepositories>
        <!-- Central first to avoid unnecessary lookups from maven.vaadin.com for all artifacts -->
        <pluginRepository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>vaadin-prereleases</id>
            <url>https://maven.vaadin.com/vaadin-prereleases</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
